# PostgreSQL 本地开发配置示例
# 复制此文件为 .env，并根据实际情况修改

# ========== PostgreSQL 配置 ==========
# 数据库类型（必填，仅支持 postgres）
SIAPP_DATABASE_TYPE=postgres

# PostgreSQL 主机
# 本地：localhost 或 127.0.0.1
# Docker：postgres（docker-compose 网络名）
# Supabase：aws-1-xxxxx.pooler.supabase.com
SIAPP_DB_HOST=localhost

# PostgreSQL 端口
SIAPP_DB_PORT=5432

# PostgreSQL 用户名
# 本地默认：postgres（管理员）或 siapp（应用用户）
# Supabase：postgres.your-project-ref
SIAPP_DB_USER=siapp

# PostgreSQL 密码（必填）
# 本地开发可使用简单密码
# 生产环境必须使用强密码（16+ 字符，包含特殊字符）
SIAPP_DB_PASSWORD=siapp_password

# PostgreSQL 数据库名
# 本地：siapp
# Supabase：postgres
SIAPP_DB_NAME=siapp

# SSL 模式
# 本地开发：disable
# 生产（Supabase）：require
# 其他选项：allow, prefer, require, require-ca, require-full
SIAPP_DB_SSLMODE=disable

# ========== 服务配置 ==========
# 后端服务监听地址
SIAPP_ADDR=:8080

# JWT 配置
# 签名密钥（生产环境至少 32 字符）
JWT_SECRET_KEY=dev-secret-change-me-in-production

# Token 有效期
JWT_TOKEN_DURATION=12h

# ========== CORS 配置 ==========
# 允许访问的前端源（逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ========== 日志配置 ==========
# 日志级别：debug, info, warn, error
LOG_LEVEL=debug

# 应用环境：development, production
APP_ENV=development

# ========== Supabase 配置（如果使用云端）==========
# Supabase URL（如使用 Supabase）
# SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key（如使用 Supabase）
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase JWT Secret（如使用 Supabase）
# SUPABASE_JWT_SECRET=your-jwt-secret

# Supabase 数据库密码（如使用 Supabase）
# SUPABASE_DB_PASSWORD=your-db-password

# ========== 前端配置（可选）==========
# 前端 API 基础地址
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# 内部 API 基址（SSR 使用）
# INTERNAL_API_BASE_URL=http://backend:8080/api
